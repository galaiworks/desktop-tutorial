# ============================================================
# 青色申告確定申告エージェント - 環境変数設定ファイル
# .env.example をコピーして .env として使用してください
# cp .env.example .env
# ============================================================

# ── Anthropic API ────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LINE Messaging API ───────────────────────────────────────
# LINE Developers Console (https://developers.line.biz/) で取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ── サーバー設定 ─────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ============================================================
# セットアップ手順
# ============================================================
#
# 1. LINE Developers Console でチャンネルを作成
#    https://developers.line.biz/console/
#    → 「Messaging API」チャンネルを作成
#    → Channel Secret と Channel Access Token を取得
#
# 2. Anthropic API キーを取得
#    https://console.anthropic.com/
#
# 3. .env ファイルを作成して上記キーを設定
#
# 4. 依存関係をインストール
#    pip install -r tax_advisor_agent/requirements.txt
#
# 5. サーバーを起動
#    python -m tax_advisor_agent.line_server
#
# 6. ngrok で外部公開（ローカル開発時）
#    ngrok http 5000
#    → 表示された https://xxx.ngrok.io/webhook を
#      LINE Developers の Webhook URL に設定
#
# ============================================================
