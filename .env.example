# NUMEN 環境変数サンプル。コピーして .env.local を作成してください。

# ── AI生成レイヤー（要件定義書 §5.5） ──
# 未設定でも動作します（決定論フォールバックのテンプレ生成に切替）。
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# ── LINE誘導（要件定義書 §5.7） ──
# 公式アカウントの友だち追加URL。診断結果は ?numen=<token> で引き継ぎます。
NEXT_PUBLIC_LINE_ADD_URL=

# ── データ永続化（要件定義書 §7。未設定なら保存は自動的に無効化されます） ──
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # サーバ側専用。絶対にクライアントへ公開しないこと

# ── LIFF（LINE内ミニアプリ。要件定義書 §5.7） ──
# 未設定の場合 /liff はフル鑑定を表示しません（無料/有料の線引きを守るため）。
NEXT_PUBLIC_LIFF_ID=
