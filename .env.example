# NUMEN 環境変数サンプル。コピーして .env.local を作成してください。

# ── AI生成レイヤー（要件定義書 §5.5） ──
# 未設定でも動作します（決定論フォールバックのテンプレ生成に切替）。
ANTHROPIC_API_KEY=
# 使用モデル（省略時 claude-sonnet-5）
ANTHROPIC_MODEL=claude-sonnet-5

# ── LINE誘導（要件定義書 §5.7） ──
# 公式アカウントの友だち追加URL。診断結果は ?numen=<token> で引き継ぎます。
NEXT_PUBLIC_LINE_ADD_URL=

# ── 将来: Supabase（要件定義書 §7 / §9。MVPでは未使用） ──
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
